---
import Layout from "../layouts/Layout.astro";

// One runway, drawn statically so it exists in the built HTML (the contract
// asserts a .runway[data-runway]; the render layer only moves planes onto it).
const runways = ["27"];
---

<Layout title="Who lands, who waits — inside air traffic control">
  <nav class="site-nav" aria-label="Site">
    <a href="#stage">Skip to the airport</a>
  </nav>

  <h1 class="sr-only">
    How air traffic control directs planes into and out of an airport
  </h1>

  <main id="stage" class="stage">
    <section class="scene" aria-label="The airport, seen from the side">
      <svg
        class="backdrop"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        role="img"
        aria-label="A low-poly airport in daylight: an open apron with room for a large plane on the left, a terminal with departure and arrival gates in the middle, the control tower on the right, and a single runway across the foreground."
      >
        <defs>
          <linearGradient id="sky-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--sky-2)"></stop>
            <stop offset="1" stop-color="var(--sky)"></stop>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="100" height="66" fill="url(#sky-grad)"></rect>
        <polygon points="0,66 26,57 52,66" fill="var(--hill-far)"></polygon>
        <polygon points="40,66 68,58 100,66" fill="var(--hill-far)"></polygon>
        <rect x="0" y="66" width="100" height="34" fill="var(--ground)"></rect>

        <!-- terminal with gates, centre -->
        <g class="terminal">
          <rect x="50" y="46" width="26" height="20" fill="var(--structure)"></rect>
          <rect x="50" y="43" width="26" height="4" fill="var(--structure-2)"></rect>
          <rect x="52" y="52" width="5" height="14" fill="var(--glass)"></rect>
          <rect x="60" y="52" width="5" height="14" fill="var(--glass)"></rect>
          <rect x="68" y="52" width="5" height="14" fill="var(--glass)"></rect>
        </g>

        <!-- control tower, right -->
        <g class="tower">
          <rect x="83" y="30" width="5" height="36" fill="var(--structure)"></rect>
          <rect x="79" y="23" width="13" height="9" fill="var(--structure-2)"></rect>
          <rect x="80.5" y="24.5" width="10" height="5.5" fill="var(--glass)"></rect>
        </g>
      </svg>

      <!-- flight board, top-left in the sky -->
      <div id="board" class="board">
        <h2 class="board-title">Flights</h2>
        <div class="board-cols">
          <div class="board-col">
            <h3 class="board-head">Arrivals</h3>
            <ul id="board-arrivals" class="board-list"></ul>
          </div>
          <div class="board-col">
            <h3 class="board-head">Takeoff</h3>
            <ul id="board-takeoff" class="board-list"></ul>
          </div>
        </div>
      </div>

      <!-- what the tower is calling now -->
      <p id="callout" class="callout" role="status" aria-live="polite"></p>

      <!-- clickable regions -->
      <button id="open-gate" class="hotspot hotspot-gate" type="button" aria-label="How gates are chosen">
        <span class="hotspot-label">Gates</span>
      </button>
      <button id="open-tower" class="hotspot hotspot-tower" type="button" aria-label="Look inside the control tower">
        <span class="hotspot-label">Tower</span>
      </button>

      <!-- the scarce runway -->
      <div class="runways" aria-hidden="true">
        {
          runways.map((id) => (
            <div class="runway" data-runway={id}>
              <span class="runway-id">RWY {id}</span>
            </div>
          ))
        }
      </div>

      <!-- planes, drawn and positioned by main.ts -->
      <div id="planes" class="planes"></div>
    </section>

    <div class="controls" role="group" aria-label="Playback">
      <button id="play" type="button" aria-pressed="true">Pause</button>
      <button id="step" type="button">Step</button>
      <button id="reset" type="button">Reset</button>
      <button id="speed" type="button" aria-label="Change playback speed">1&#215;</button>
    </div>
  </main>

  <!-- popups -->
  <div id="popup-gate" class="popup" hidden>
    <div class="popup-backdrop" data-close></div>
    <div class="popup-card" role="dialog" aria-modal="true" aria-labelledby="popup-gate-title">
      <button class="popup-close" type="button" data-close aria-label="Close">Close</button>
      <h2 id="popup-gate-title" class="popup-title">Choosing a gate</h2>
      <div class="popup-body">
        <p>
          A gate is not simply the nearest free door. Ground control matches each
          plane to a stand that actually fits it and keeps the apron flowing.
        </p>
        <ul>
          <li>
            <strong>Size.</strong> The stand and jet bridge have to fit the
            aircraft. A large widebody cannot use a small regional stand.
          </li>
          <li>
            <strong>Airline and terminal.</strong> Airlines are grouped by
            terminal so passengers and baggage stay close to their connections.
          </li>
          <li>
            <strong>Ground traffic.</strong> A gate is picked so the plane can
            taxi in and push back later without blocking everyone behind it.
          </li>
          <li>
            <strong>Turnaround.</strong> A quick turnaround earns a stand near the
            runway; a long layover can sit further out.
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div id="popup-tower" class="popup" hidden>
    <div class="popup-backdrop" data-close></div>
    <div class="popup-card" role="dialog" aria-modal="true" aria-labelledby="popup-tower-title">
      <button class="popup-close" type="button" data-close aria-label="Close">Close</button>
      <h2 id="popup-tower-title" class="popup-title">Inside the control tower</h2>
      <div class="popup-body">
        <p>
          From the tower, one controller owns the runway. Every call answers a
          single question: who uses it next?
        </p>
        <ul>
          <li>
            <strong>One runway, one plane.</strong> The runway serves a single
            aircraft at a time, so each clearance is a choice about who waits.
          </li>
          <li>
            <strong>Fuel is the clock.</strong> Holding arrivals burn fuel, so
            the arrival with the least fuel is cleared first, and an empty tank
            forces the call.
          </li>
          <li>
            <strong>Arrivals before departures.</strong> A plane already in the
            air comes before one waiting safely at the gate.
          </li>
        </ul>
        <p>
          Watch the board and the callout as the demo runs: that is the
          controller thinking out loud.
        </p>
      </div>
    </div>
  </div>

  <div id="popup-plane" class="popup" hidden>
    <div class="popup-backdrop" data-close></div>
    <div class="popup-card" role="dialog" aria-modal="true" aria-labelledby="popup-plane-title">
      <button class="popup-close" type="button" data-close aria-label="Close">Close</button>
      <h2 id="popup-plane-title" class="popup-title">Plane</h2>
      <div class="popup-body">
        <p id="popup-plane-body"></p>
      </div>
    </div>
  </div>

  <script src="../scripts/main.ts"></script>
</Layout>
