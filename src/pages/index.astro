---
import Layout from "../layouts/Layout.astro";

// Runways are rendered statically so they exist in the built HTML (the render
// layer only moves planes onto them). Keep this list in sync with
// createInitialState() in src/scripts/sequencer.ts.
const runways = ["27", "34"];
---

<Layout title="One runway, many planes — how ATC decides who lands">
  <header>
    <nav aria-label="Views">
      <button id="view-tower-btn" class="nav-btn" type="button" data-view="airport" aria-current="true">Tower</button>
      <button id="view-map-btn" class="nav-btn" type="button" data-view="map">Sky map</button>
    </nav>
  </header>

  <main>
    <h1>One runway, many planes</h1>
    <p class="lede">
      An airport can only ever land or launch <strong>one plane at a time per
      runway</strong>, and each plane in the sky is burning fuel while it waits.
      That single bottleneck is the whole job of air traffic control: decide who
      goes next. You are in the tower. Clear planes onto a runway, and watch who
      has to keep circling.
    </p>

    <div class="views">
      <!-- Airport: side-on view -->
      <section
        id="view-airport"
        class="view scene"
        aria-label="Side-on view of the airport"
      >
        <svg
          class="backdrop"
          viewBox="0 0 100 60"
          preserveAspectRatio="xMidYMid slice"
          role="img"
          aria-label="A low-poly airport: control tower on the left, terminal on the right, runways along the ground, and planes holding in the sky above."
        >
          <rect x="0" y="0" width="100" height="44" fill="var(--sky)"></rect>
          <polygon points="0,44 18,33 34,44" fill="var(--hill-far)"></polygon>
          <polygon points="22,44 46,30 70,44" fill="var(--hill-far)"></polygon>
          <polygon points="58,44 82,34 100,44" fill="var(--hill-far)"></polygon>
          <rect x="0" y="44" width="100" height="16" fill="var(--ground)"></rect>
          <!-- ATC tower, left (a click target to the tower interior later) -->
          <g class="tower">
            <polygon points="6,44 10,44 9,20 7,20" fill="var(--structure)"></polygon>
            <polygon points="5.5,20 10.5,20 11,14 5,14" fill="var(--structure-2)"></polygon>
            <polygon points="6,14 10,14 10,11 6,11" fill="var(--glass)"></polygon>
          </g>
          <!-- terminal, right -->
          <g class="terminal">
            <polygon points="80,44 98,44 98,32 86,32 80,37" fill="var(--structure)"></polygon>
            <polygon points="86,32 98,32 98,29 90,29" fill="var(--structure-2)"></polygon>
          </g>
        </svg>

        <button id="sky-to-map" type="button" class="sky-hit" aria-label="Open the sky map">
          <span class="sky-hint">Tap the sky for the map</span>
        </button>

        <div class="ground-strips" aria-hidden="true">
          {
            runways.map((id, i) => (
              <div class="runway" data-runway={id} style={`--lane:${i};`}>
                <span class="runway-id">RWY {id}</span>
              </div>
            ))
          }
        </div>
        <div id="planes" class="planes" aria-hidden="true"></div>
      </section>

      <!-- Sky map: top-down view -->
      <section
        id="view-map"
        class="view map-wrap"
        aria-label="Top-down map of the sky around the airport"
        hidden
      >
        <svg
          class="map"
          viewBox="0 0 100 100"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="A radar-style top-down map: the airport and its two runways at the centre, a holding fix to the north-east where arrivals circle, and each aircraft's recent track."
        >
          <rect x="0" y="0" width="100" height="100" fill="var(--radar)"></rect>
          <!-- range rings -->
          <circle cx="50" cy="58" r="40" class="ring"></circle>
          <circle cx="50" cy="58" r="26" class="ring"></circle>
          <circle cx="50" cy="58" r="12" class="ring"></circle>
          <!-- runways, top-down -->
          <g class="map-runways">
            <rect x="34" y="56.5" width="32" height="3" rx="1" data-map-runway="27"></rect>
            <rect x="48.5" y="44" width="3" height="28" rx="1" transform="rotate(-20 50 58)" data-map-runway="34"></rect>
          </g>
          <text x="67" y="60.5" class="map-label">27</text>
          <text x="41" y="43" class="map-label">34</text>
          <!-- holding fix -->
          <circle cx="76" cy="26" r="1.6" class="fix"></circle>
          <text x="79" y="27" class="map-label">HOLD</text>
          <!-- compass -->
          <text x="50" y="8" class="compass">N</text>
          <!-- trails and live aircraft are drawn by main.ts -->
          <g id="map-trails"></g>
          <g id="map-planes"></g>
        </svg>
        <p class="map-hint">
          Arrivals circle the holding fix, burning fuel, until you clear one to a
          runway. Their tracks fade behind them.
        </p>
      </section>
    </div>

    <section class="panel" aria-label="Controls and flight strips">
      <div class="controls">
        <button id="add-arrival" type="button">+ Arrival</button>
        <button id="add-departure" type="button">+ Departure</button>
        <button id="pause" type="button" aria-pressed="false">Pause</button>
        <button id="reset" type="button">Reset</button>
      </div>

      <div class="stats" role="status" aria-live="polite">
        <span id="stat-landed">Landed 0</span>
        <span id="stat-departed">Departed 0</span>
        <span id="stat-emergency" class="danger">Emergencies 0</span>
      </div>

      <h2 class="board-title">Flight strips</h2>
      <p id="board-empty" class="board-empty" hidden>
        Quiet skies. Add an arrival or a departure.
      </p>
      <ul id="board" class="board" aria-label="Waiting and active flights"></ul>
    </section>

    <footer class="note">
      <p>
        Fuel drains while a plane holds. Let it hit zero and the flight declares
        an emergency and jumps the queue, which is exactly why a controller
        cannot just serve arrivals in the order they turned up.
      </p>
    </footer>
  </main>

  <script src="../scripts/main.ts"></script>
</Layout>
