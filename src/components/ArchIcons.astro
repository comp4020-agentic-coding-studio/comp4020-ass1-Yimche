      <polygon points="4,20 6,6 8,20"></polygon>
      <polygon points="9,20 12,4 15,20"></polygon>
      <polygon points="16,20 18,7 20,20"></polygon>
    </g>
  </symbol>

  <symbol id="arch-aksum" viewBox="0 0 24 24">
    <g fill="currentColor">
