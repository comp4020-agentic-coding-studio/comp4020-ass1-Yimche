---
// A hidden inline SVG sprite: one silhouette of each civilisation's signature
// architecture, keyed to its id. Hand-authored coarse shapes, so it is CC0 by
// construction (no external image, no CDN, no licence to clear when the repo
// goes public), the same discipline WorldMap.astro uses for its land geometry.
// The focus medallions in main.ts reference these by <use href="#arch-<id>">.
// Every shape uses currentColor, so the medallion's CSS colour paints them.
//
// One symbol per civ id; spec/interaction.test.ts fails if any id has no icon.
---

<svg class="arch-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <!-- Mesopotamia -->
  <symbol id="arch-sumer" viewBox="0 0 24 24">
    <polygon
      fill="currentColor"
      points="2,20 2,16 6,16 6,12 9,12 9,8 15,8 15,12 18,12 18,16 22,16 22,20"
    ></polygon>
  </symbol>

  <symbol id="arch-babylon" viewBox="0 0 24 24">
    <g fill="currentColor">
      <path d="M3 20 V8 H21 V20 H15 V13 Q15 8 12 8 Q9 8 9 13 V20 Z"></path>
      <rect x="3" y="6" width="3" height="2"></rect>
      <rect x="10" y="6" width="4" height="2"></rect>
      <rect x="18" y="6" width="3" height="2"></rect>
    </g>
  </symbol>

  <!-- Egypt & Africa -->
  <symbol id="arch-egypt" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon points="2,20 11,4 20,20"></polygon>
      <polygon points="14,20 19,10 23,20"></polygon>
    </g>
  </symbol>

  <symbol id="arch-kush" viewBox="0 0 24 24">
