  </symbol>

  <symbol id="arch-japan-korea" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon points="1,7 23,7 21,4 3,4"></polygon>
      <rect x="4" y="10" width="16" height="1.6"></rect>
      <rect x="6" y="6" width="2.5" height="14"></rect>
      <rect x="15.5" y="6" width="2.5" height="14"></rect>
    </g>
  </symbol>

  <symbol id="arch-southeast-asia" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="6" y="17" width="12" height="3"></rect>
      <polygon points="8,17 16,17 15,13 9,13"></polygon>
      <polygon points="9,13 15,13 14,9 10,9"></polygon>
      <polygon points="10,9 14,9 13,5 11,5"></polygon>
      <polygon points="11,5 13,5 12,2"></polygon>
    </g>
  </symbol>

  <!-- Mediterranean & Europe -->
  <symbol id="arch-classical-med" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon points="2,9 12,3 22,9"></polygon>
      <rect x="3" y="9" width="18" height="2"></rect>
      <rect x="3" y="11" width="2" height="8"></rect>
      <rect x="7" y="11" width="2" height="8"></rect>
      <rect x="11" y="11" width="2" height="8"></rect>
      <rect x="15" y="11" width="2" height="8"></rect>
      <rect x="19" y="11" width="2" height="8"></rect>
      <rect x="2" y="19" width="20" height="2"></rect>
    </g>
  </symbol>

  <symbol id="arch-medieval-europe" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="3" y="13" width="18" height="7"></rect>
      <path d="M6 13 A6 6 0 0 1 18 13 Z"></path>
      <rect x="11.6" y="5" width="0.8" height="2"></rect>
      <path d="M2 13 A3 3 0 0 1 8 13 Z"></path>
      <path d="M16 13 A3 3 0 0 1 22 13 Z"></path>
    </g>
  </symbol>

  <symbol id="arch-modern-europe" viewBox="0 0 24 24">
    <g fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M8 20 V7 H16 V20 Z M6.5 7 L12 1 L17.5 7 Z M6 20 H18 V22 H6 Z M14 11 A2 2 0 1 0 10 11 A2 2 0 1 0 14 11 Z"
      ></path>
      <circle cx="12" cy="11" r="0.5"></circle>
    </g>
  </symbol>

  <!-- Mesoamerica -->
  <symbol id="arch-mesoamerica" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon
        points="3,20 3,17 6,17 6,14 9,14 9,11 15,11 15,14 18,14 18,17 21,17 21,20"
      ></polygon>
      <rect x="10" y="7" width="4" height="4"></rect>
    </g>
  </symbol>

  <!-- Andes -->
  <symbol id="arch-andes" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon points="1,20 9,5 19,20"></polygon>
      <path d="M8 20 L9 11 H17 L18 20 H14 V15 H12 V20 Z"></path>
    </g>
  </symbol>
</svg>
