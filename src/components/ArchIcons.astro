---
// A hidden inline SVG sprite: one silhouette of the signature architecture of
// each group, keyed to the group id. Hand-authored coarse shapes, so it is CC0
// by construction (no external image, no CDN, no licence to clear when the repo
// goes public), the same discipline WorldMap.astro uses for its land geometry.
// The focus medallions in main.ts reference these by <use href="#arch-<id>">,
// where the id is iconFor(civ): a civ's own icon override, else its group.
// Every shape uses currentColor, so the medallion's CSS colour paints them.
//
// One symbol per group id; spec/interaction.test.ts fails if any civilisation's
// iconFor resolves to a symbol that is not authored here.
---

<svg class="arch-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <!-- Mesopotamia -->
  <symbol id="arch-mesopotamia" viewBox="0 0 24 24">
    <polygon
      fill="currentColor"
      points="2,20 2,16 6,16 6,12 9,12 9,8 15,8 15,12 18,12 18,16 22,16 22,20"
    ></polygon>
  </symbol>

  <!-- Persia & Near East -->
  <symbol id="arch-levant" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="3" y="6" width="4" height="14"></rect>
      <rect x="17" y="6" width="4" height="14"></rect>
      <path d="M7 20 V12 Q12 7 17 12 V20 Z"></path>
      <polygon points="3,6 5,3 7,6"></polygon>
      <polygon points="17,6 19,3 21,6"></polygon>
    </g>
  </symbol>

  <symbol id="arch-persia" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="3" y="5" width="18" height="2.5"></rect>
      <rect x="4" y="6.5" width="2.5" height="1.5"></rect>
      <rect x="8.5" y="6.5" width="2.5" height="1.5"></rect>
      <rect x="13" y="6.5" width="2.5" height="1.5"></rect>
      <rect x="17.5" y="6.5" width="2.5" height="1.5"></rect>
      <rect x="4.5" y="8" width="1.5" height="11.5"></rect>
      <rect x="9" y="8" width="1.5" height="11.5"></rect>
      <rect x="13.5" y="8" width="1.5" height="11.5"></rect>
      <rect x="18" y="8" width="1.5" height="11.5"></rect>
      <rect x="3" y="19.5" width="18" height="1.5"></rect>
    </g>
  </symbol>

  <symbol id="arch-islamic-world" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="5" y="13" width="14" height="7"></rect>
      <path d="M7 13 A5 5 0 0 1 17 13 Z"></path>
      <rect x="11.6" y="5" width="0.8" height="3"></rect>
      <path d="M4 13 A2 2 0 0 1 8 13 Z"></path>
      <path d="M16 13 A2 2 0 0 1 20 13 Z"></path>
      <polygon points="2,20 2,4 2.8,1.5 3.6,4 3.6,20"></polygon>
      <polygon points="20.4,20 20.4,4 21.2,1.5 22,4 22,20"></polygon>
    </g>
  </symbol>

  <!-- Egypt & Africa -->
  <symbol id="arch-nile-egypt" viewBox="0 0 24 24">
    <g fill="currentColor">
      <polygon points="2,20 11,4 20,20"></polygon>
      <polygon points="14,20 19,10 23,20"></polygon>
    </g>
  </symbol>

  <symbol id="arch-sub-saharan-africa" viewBox="0 0 24 24">
    <g fill="currentColor">
      <path d="M9 20 V6 Q9 3 12 3 Q15 3 15 6 V20 Z"></path>
      <rect x="7" y="20" width="10" height="1.6"></rect>
    </g>
  </symbol>

  <!-- South Asia -->
  <symbol id="arch-ancient-india" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="4" y="17" width="16" height="3"></rect>
      <path d="M5 17 A7 7 0 0 1 19 17 Z"></path>
      <rect x="11" y="8" width="2" height="2"></rect>
      <rect x="11.6" y="4" width="0.8" height="4"></rect>
      <circle cx="12" cy="4" r="1.1"></circle>
    </g>
  </symbol>

  <symbol id="arch-medieval-india" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="7" y="12" width="10" height="8"></rect>
      <path d="M8 12 Q8 5 12 4 Q16 5 16 12 Z"></path>
      <rect x="11.6" y="1.5" width="0.8" height="2.5"></rect>
      <rect x="3" y="8" width="2" height="12"></rect>
      <rect x="19" y="8" width="2" height="12"></rect>
      <path d="M3 8 A1 1 0 0 1 5 8 Z"></path>
      <path d="M19 8 A1 1 0 0 1 21 8 Z"></path>
    </g>
  </symbol>

  <!-- East Asia -->
  <symbol id="arch-steppe" viewBox="0 0 24 24">
    <g fill="currentColor">
      <path d="M3 20 V13 Q12 4 21 13 V20 Z"></path>
      <rect x="10.5" y="9" width="3" height="3"></rect>
    </g>
  </symbol>

  <symbol id="arch-china" viewBox="0 0 24 24">
    <g fill="currentColor">
      <rect x="6" y="19" width="12" height="2"></rect>
      <rect x="8" y="15" width="8" height="4"></rect>
      <polygon points="3,15 21,15 17,12 7,12"></polygon>
      <rect x="9" y="11" width="6" height="1"></rect>
      <polygon points="5,11 19,11 16,8 8,8"></polygon>
      <polygon points="7,7 17,7 14,5 10,5"></polygon>
      <rect x="11.5" y="2" width="1" height="3"></rect>
